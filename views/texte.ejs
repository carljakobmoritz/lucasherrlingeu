<%- include('partials/header') %>
<h1>Texte</h1>
<% if (essays.length) { %>
    <ul class="list-unstyled prose">
        <% for (const essay of essays) { %>
            <li class="my-4">
                <h2 class="h4"><a href="<%= essay.url %>"><%= essay.title %></a></h2>
                <% if (essay.excerptHtml) { %><p><%- essay.excerptHtml %></p><% } %>
            </li>
        <% } %>
    </ul>
<% } else { %>
    <p>Hier erscheinen demnächst Texte.</p>
<% } %>
<%- include('partials/footer') %>
